# ==========================================
# AI Job Opportunity Agent Environment Config
# Copy this file to .env and fill in your details
# ==========================================

# Application Config
PORT=3010
NODE_ENV=development
CANDIDATE_NAME="Uday Singh Kushwah"
CANDIDATE_EMAIL="toudaysinghkushwah@gmail.com"

# LLM Provider Configuration ('gemini', 'openai', or 'mock')
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (MongoDB Atlas / Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.l5elqrt.mongodb.net/job_opportunity_agent?retryWrites=true&w=majority

# Gmail SMTP Email Dispatch & IMAP Live Inbox Watcher
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Notification Webhooks & Integrations (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
