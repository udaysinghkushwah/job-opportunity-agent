{
  "name": "job-opportunity-agent",
  "version": "1.0.0",
  "description": "Production-ready Agentic AI system for handling recruiter job opportunities end-to-end",
  "main": "dist/apps/api/server.js",
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "cd apps/web && npx ng build",
    "start": "node dist/apps/api/server.js",
    "dev": "ts-node apps/api/server.ts",
    "dev:api": "ts-node apps/api/server.ts",
    "dev:ui": "cd apps/web && npx ng serve --port 4200",
    "test": "ts-node tests/workflow.test.ts"
  },
  "keywords": [
    "ai-agent",
    "agentic-ai",
    "recruiter-automation",
    "job-opportunity-agent",
    "llm",
    "mongodb",
    "gmail-api"
  ],
  "author": "Uday Singh Kushwah",
  "license": "MIT",
  "dependencies": {
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imap": "^0.8.19",
    "mailparser": "^3.9.15",
    "mongoose": "^8.3.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imap": "^0.8.43",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.2"
  }
